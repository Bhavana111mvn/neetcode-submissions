https://leetcode.com/problems/delete-operation-for-two-strings/description/
Given two strings word1 and word2, return the minimum number of steps required to make word1 and word2 the same.

In one step, you can delete exactly one character in either string.

 

Example 1:



func minDistance(word1 string, word2 string) int {
    memo := make(map[[2]int]int)
    return len(word1)+len(word2)-2*findlcs(len(word1),len(word2),word1,word2,memo)
}


func findlcs(i,j int , word1, word2 string,memo map[[2]int]int) int {
    if i==0 ||j==0 {
        return 0
    }
    key := [2]int{i,j}
    if _, ok:= memo[key]; ok {
        return memo[key]
    }
    if word1[i-1] == word2[j-1] {
        return 1+findlcs(i-1,j-1,word1,word2,memo)
    } 
    res := max(findlcs(i,j-1,word1,word2,memo), findlcs(i-1,j,word1,word2,memo))
    memo[key] = res
    return res
}
