https://leetcode.com/problems/edit-distance/

Given two strings word1 and word2, return the minimum number of operations required to convert word1 to word2.

You have the following three operations permitted on a word:

Insert a character
Delete a character
Replace a character


func minDistance(word1 string, word2 string) int {
    //memo := make(map[[2]int]int)
    if len(word1)==0 && len(word2)==0 {
        return 0
    }
    if word1==word2 {
        return 0
    }
    dp := make([][]int, len(word1)+1)
    for i:= range dp {
        dp[i]=make([]int, len(word2)+1)
        dp[i][0] = i
    }
    for i:=0;i<len(dp[0]);i++ {
        dp[0][i]= i
    }
    dp[0][0] = 0
    for i:=1; i<len(dp);i++ {
        for j:=1; j<len(dp[0]);j++ {
            delete, replace, insert := int(1e9),int(1e9),int(1e9)
            if word1[i-1] == word2[j-1] {
                dp[i][j] = dp[i-1][j-1]
            } else {
                delete = 1 + dp[i-1][j]
                replace = 1 + dp[i-1][j-1]
                insert = 1 + dp[i][j-1]
                dp[i][j]=min(delete, replace, insert)
            }
        }
    }
    //fmt.Println(dp)
    return dp[len(dp)-1][len(dp[0])-1]
    //return recurs(len(word1),len(word2),word1,word2,memo)
}


func recurs(i int, j int, word1 string, word2 string, memo map[[2]int]int)int {
    if i == 0 {
        return j
    }
    if j == 0 {
        return i
    }
    key := [2]int{i,j}
    if _, ok:= memo[key]; ok {
        return memo[key]
    }
    delete, replace, insert := int(1e9),int(1e9),int(1e9)
    if word1[i-1]== word2[j-1] {
        return recurs(i-1,j-1,word1,word2,memo)
    } else {
        delete = 1 + recurs(i-1, j, word1, word2,memo)
        replace = 1 + recurs(i-1,j-1, word1,word2,memo)
        insert = 1 + recurs(i,j-1, word1,word2,memo)
    }
    memo[key]=min(delete, replace, insert)
    return min(delete, replace, insert)
}
