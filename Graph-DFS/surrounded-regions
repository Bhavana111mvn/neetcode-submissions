https://leetcode.com/problems/surrounded-regions/

func solve(board [][]byte)  {
    visited := make([][]bool, len(board))
    for i:= range visited {
        visited[i] = make([]bool, len(board[0]))
    }
    for i:=0; i<len(board);i++ {
        for j:=0; j<len(board[0]);j++ {
            if (i==0 ||i==len(board)-1 || j==0 || j==len(board[0])-1) && board[i][j] == 'O' {
                /// do dfs from here
                dfs(board,i,j,visited)
            }
        }
    }
    for i:=0; i<len(board);i++ {
        for j:=0; j<len(board[0]);j++ {
            if (i!=0 && i!=len(board)-1 && j!=0 && j!=len(board[0])-1) && board[i][j] == 'O' {
                if !visited[i][j] {
                    board[i][j]='X'
                }
            }
        }
    }
}

func dfs(board [][]byte, i, j int, visited [][]bool) {
    nbrlst := [][2]int{{-1,0}, {1,0}, {0,-1}, {0,1}}
    for _, nbr := range nbrlst {
        p,q:= i+nbr[0], j+nbr[1]
        if p<0 || p==len(board) || q<0 || q==len(board[0]) {
            continue
        }
        if board[p][q] == 'O' && !visited[p][q] {
            visited[p][q]= true
            dfs(board, p,q, visited)
        } 

    }
    visited[i][j]=true
    return
}



