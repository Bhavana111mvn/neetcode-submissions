func minEatingSpeed(piles []int, h int) int {
    maxi := 0
    for _, pile := range piles {
        maxi = max(pile,maxi)
    }
    /// eating speed rate can vary between 1 and maxi
    start, end:=1, maxi
    mid :=0
    for start <= end {
        mid = start+(end-start)/2
        if noofhoursReq(piles, mid) > h {
             /// increase speed
            start = mid+1
        } else {
            end = mid-1
        }
    }
    return start
}

func noofhoursReq(piles []int, k int) int {
    hours :=0
    for _, pile := range piles {
        if pile%k == 0 {
            hours+=pile/k
        } else {
            hours+=(pile/k)+1
        }
    }
    return hours
}
