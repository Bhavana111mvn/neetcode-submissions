func searchRange(nums []int, target int) []int {
    left_most := findLeftmost(nums,target)
    right_most := findRightmost(nums,target)
    finalarr := []int{left_most,right_most}
    return finalarr
}

func findLeftmost(nums []int, target int) int {
    left_most :=-1
    start, end, mid  := 0, len(nums)-1, 0 
    for start <=end {
        mid = start+(end-start)/2
        if target < nums[mid] {
            end = mid-1
        } else if target > nums[mid] {
            start = mid+1
        } else {
            left_most = mid // possibly answer
            end = mid-1
        }
    }
    return left_most

}

func findRightmost(nums []int, target int) int {
    right_most :=-1
    start, end, mid := 0, len(nums)-1, 0
    for start <=end {
        mid = start+(end-start)/2
        if target < nums[mid] {
            end = mid-1
        } else if target > nums[mid] {
            start = mid+1
        } else {
            right_most = mid // possibly answer
            start = mid+1
        }
    }
    return right_most

}
